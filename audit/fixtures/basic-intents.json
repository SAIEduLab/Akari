  "cases": [
    {
      "id": "T01",
      "source": "あかりがクリックされたとき、\n  あかりはいまのばしょから、右へ30歩動いて、「今日はどこへ行こう」と言う。",
      "sourceSha256": "59d5ce1f7b35611ee6adb862b490762da94e2b24fbef04a9da2b3661aa9e0772"
    },
    {
      "id": "T02",
      "source": "「空白」キーを押すたびに、あかりは、\n  いまのばしょから、上へ24歩動いて、0.5秒待って、いまのばしょから、下へ24歩動く。",
      "sourceSha256": "d252a96be45791daf0d55044af842bf42ffe85c70c87238f03538041541f6fea"
    },
    {
      "id": "T03",
      "source": "「右」キーが押されているあいだは、あかりは右へ1秒に30歩の速さで動き続ける。",
      "sourceSha256": "52f47a1270b5bab0fbcc5406b21ec0f47f256bfb9a81d894291cb9874784a409"
    },
    {
      "id": "T04",
      "source": "作品を動かしたとき、あかりは、\n  あかりはいまのばしょから、右へ20歩動いて、「先に行くね」と言う。\n  そのあと、星はいまのばしょから、左へ15歩動いて、「ついていくよ」と言う。",
      "sourceSha256": "789f4ae90b7af8a430fe319e939399481378c4d56cba678dd496d28679dc5f21"
    },
    {
      "id": "T05",
      "source": "作品を動かしたとき、あかりは、\n  姿を隠して、1秒待って、姿を見せて、「ただいま」と言う。",
      "sourceSha256": "728acf3a6ee7aceb310b01b4ce99bb5f460304a8c949bda985d2230bbaa77c3d"
    },
    {
      "id": "T06",
      "source": "作品を動かしたとき、あかりは、\n  ペンを下ろす。\n  前へ20歩進んで、右に90度回ることを4回くり返す。\n  ペンを上げる。",
      "sourceSha256": "b241e31163944368c8bf786ce16aa7664da7b602d408ef5b23374298ad91fb4d"
    },
    {
      "id": "T13",
      "source": "「右」キーが押されているあいだ、あかりは1秒に20歩の速さで右へ動く。",
      "sourceSha256": "b4976d06ced7b169128f87314bce7ee6dc59ce6f3d1abc2b8e42a57267e93285"
    }
  ]
}
