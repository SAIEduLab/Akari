          "after": "    await number(p).fill('5'); await click(p,'#blockEditor [data-blockui-action=\"commit\"]'); assert.equal((await fingerprint(p)).source,'5を言う。'); assert.equal((await fingerprint(p)).history,mainBefore.history+1); await settledHidden(p.locator('#blockEditor [data-blockui-action=\"commit\"]')); await visible(p,'#blockEditor [data-blockui-action=\"commit\"]',false);\n",
          "applications": 1,
          "beforeOccurrences": 1,
          "afterOccurrences": 1
        },
